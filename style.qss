#tempLabel{
    font-size: 30px;
    font-weight: bold;
}

#tempsLabel {
    font-size: 15px;
}

#code_country {
    font-size: 15px;
    font-weight: bold;
}

#nomville {
    font-size: 15px;
}

#widgetVille {
    max-width: 228px;
    min-width: 228px;

    min-height: 160px;
    max-height: 160px;
}

/* background blanc */
#widgetVille, #meteo_actuelle, #meteo_journee, #meteo_semaine {
    background-color: #D2D2D2;
    border-radius: 10px;
}

#meteo_nom_ville {
    font-size: 20px;
    font-weight: bold;
}

#meteo_temps {
    font-size: 15px;
}

#meteo_temperature {
    font-size: 25px;
    font-weight: bold;
}

#meteo_humidity {
    font-size: 25px;
}

/*Meteo Journee*/

#meteoHeureLabel {
    font-size: 20px;
    font-weight: bold;
}

#meteo_icon {

}

#meteoTemp {
    font-size: 18px;
    font-weight: bold;
}

#precipProba {
    font-size: 18px;
    font-weight: bold;
}

/* Meteo Semaine */

#meteo_jour_semaine {
    font-size: 20px;
    font-weight: bold;
}

#meteo_temp_semaine {
    font-size: 18px;
    font-weight: bold;
}

#meteo_temp_min {
    font-size: 18px;
    font-weight: bold;
    color: rgb(66, 116, 217);
}

#meteo_temp_max {
    font-size: 18px;
    font-weight: bold;
    color: rgb(149, 39, 29);
}

#meteo_preci_semaine {
    font-size: 18px;
    font-weight: bold;
}

#boutonMenu {
    font-size: 18px;
    padding: 10px 20px;
    background-color: #4CAF50;
    border-radius: 0px;
}

#boutonMenu:hover {
    background-color: #45a049;
}

#boutonMenu:pressed {
    background-color: #ffffff;
    color: #4CAF50;
}

/* Ville Favoris */
#ListeWidget::item {
    color: white;
    padding: 8px;
    border-radius: 5px;
    color: black;
    font-weight: 20px;
    margin: 2px;
}

#ListeWidget::item:hover {
    background-color: #0093F9;
}

#ListeWidget::item:selected {
    background-color: #2885C7;
}

/* Bouton de ville favoris */
#buttonAddCity {
    width: 100px;
    height: 30px;
    border-radius: 5px;
    background-color: #0093D6;
}

#buttonAddCity:hover {
    width: 100px;
    height: 30px;
    border-radius: 5px;
    border: 2px solid #0093D6;
    background-color: #217AA3;
}

/* Scroll Area de Body */
#scrollArea {
    border : none;
    background-color: transparent;
}

/* Conteneur Meteo dans Body */
#meteo_conteneur {
    background-color: transparent;
}